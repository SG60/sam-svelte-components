{
	"name": "sam-svelte-components",
	"description": "monorepo for @samsveltecomponents",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "git://github.com/sg60/sam-svelte-components.git"
	},
	"private": true,
	"scripts": {
		"build": "turbo run build",
